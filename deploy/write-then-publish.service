[Unit]
Description=Write Then Publish private card editor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=write-then-publish
Group=write-then-publish
WorkingDirectory=/opt/write-then-publish/current
EnvironmentFile=/etc/write-then-publish/app.env
EnvironmentFile=/etc/write-then-publish/server.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/write-then-publish/current/.venv/bin/python server.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=30
UMask=0077
Nice=5
CPUQuota=100%
MemoryHigh=768M
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096
OOMPolicy=stop

StateDirectory=write-then-publish
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/write-then-publish

[Install]
WantedBy=multi-user.target
