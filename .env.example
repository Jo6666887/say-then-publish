# Server-only Supabase connection. Never put the secret key in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-secret

# Private Volcengine TOS bucket used for the persistent asset library.
TOS_ACCESS_KEY=replace_me
TOS_SECRET_KEY=replace_me
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=your-private-bucket
TOS_KEY_PREFIX=write-then-publish/assets/

# All collaborators using the same value share one cloud workspace.
WRITE_THEN_PUBLISH_WORKSPACE_ID=your-workspace
WRITE_THEN_PUBLISH_CLOUD_SYNC=1

# Optional local fallback directory. Leave it unset to ask the user to choose
# a folder from the resource library's native picker on first use.
# WRITE_THEN_PUBLISH_ASSET_DIR=/absolute/path/to/your/assets

# Optional server-only AI layout/polish service (Xunfei MaaS, OpenAI-compatible).
# Leave these unset to disable AI safely. Never put these values in browser code.
WTP_AI_API_BASE=https://maas-api.cn-huabei-1.xf-yun.com/v2
WTP_AI_API_KEY=replace-with-a-new-rotated-key
WTP_AI_APP_ID=replace-with-app-id
WTP_AI_MODEL_ID=xopkimik25
WTP_AI_RESOURCE_ID=0
# WTP_AI_TIMEOUT_SECONDS=90
# WTP_AI_POLISH_TIMEOUT_SECONDS=180
# WTP_AI_MAX_TOKENS=8192
